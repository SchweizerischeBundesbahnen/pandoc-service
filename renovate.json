{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SchweizerischeBundesbahnen/casc-renovate-preset-polarion-docker"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jgm/pandoc",
      "matchStrings": [
        "PANDOC_VERSION=(?<currentValue>.*)"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "jgm/pandoc"
      ],
      "semanticCommitType": "feat",
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "jgm/pandoc"
      ],
      "semanticCommitType": "feat!",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "jgm/pandoc"
      ],
      "semanticCommitType": "fix",
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "description": "weasysvg is ours and changes what the service draws: take each release at once, and review it",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "A minor release of weasysvg is a feature of the service: release-please takes it as a minor release",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat"
    },
    {
      "description": "A major release of weasysvg may change what a document looks like: release-please takes it as a major release",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat!"
    }
  ]
}
